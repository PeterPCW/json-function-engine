{
  "name": "json-function-engine",
  "version": "0.9.2",
  "description": "Standalone JSON function engine for executing functions defined in JSON configuration",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "build:types": "tsc --declaration --declarationMap",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts --fix",
    "lint:view": "eslint src --ext .ts",
    "all": "eslint src --ext .ts && tsc --declaration --declarationMap && vitest run --coverage"
  },
  "keywords": [
    "json",
    "functions",
    "engine",
    "linter",
    "validator",
    "scanner"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitest/coverage-v8": "^4.1.0",
    "attune": "^0.8.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
